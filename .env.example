# Custom LLM Fine-Tuning Platform - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llm_platform
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Database URL (constructed automatically, or override manually)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/llm_platform

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================
GCS_PROJECT=your-gcp-project-id
GCS_BUCKET=llm-platform-datasets-llm-finetuning-480620
GCS_DATASETS_BUCKET=llm-platform-datasets
GCS_ADAPTERS_BUCKET=llm-platform-adapters
GCS_ADAPTERS_BUCKET=llm-platform-adapters
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Enable GCS storage for datasets (set to true to upload datasets to GCS)
USE_GCS=true

# =============================================================================
# MLFLOW TRACKING
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=llm-finetuning

# =============================================================================
# AIRFLOW
# =============================================================================
AIRFLOW_HOME=./orchestration/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:password@localhost:5432/airflow

# =============================================================================
# MONITORING & ALERTING (SMTP for Pipeline Notifications)
# =============================================================================
# Email is REQUIRED for pipeline notifications
EMAIL_ENABLED=true

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email sender for notifications
EMAIL_SENDER=your-email@gmail.com

# Admin email for failure notifications (receives all failures)
ALERT_EMAIL=mlopsproject25@gmail.com

# Slack integration (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
